{
  "expo": {
    "name": "Central Melhor Idade",
    "slug": "central-melhor-idade",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "platforms": [
      "android",
      "ios"
    ],
    "updates": {
      "url": "https://u.expo.dev/f2583739-19d1-4d18-9c84-eea93de131ed"
    },
    "ios": {
      "bundleIdentifier": "com.revosolutions.cmi",
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      }
    },
    "android": {
      "package": "com.revosolutions.cmi",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#7E3369",
          "enableRemoteNotifications": true,
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-secure-store",
      "expo-background-task",
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O pedido de ajuda leva um link do mapa com o lugar onde você está, para o seu contato de confiança chegar até você.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f2583739-19d1-4d18-9c84-eea93de131ed"
      }
    },
    "owner": "revosolutions"
  }
}
